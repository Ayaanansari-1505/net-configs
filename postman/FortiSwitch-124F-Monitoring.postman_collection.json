    {
      "name": "2 \u00b7 Ports, PoE & optics",
      "item": [
        {
          "name": "All ports \u2014 link state, speed & counters",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v2/monitor/switch/port",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v2",
                "monitor",
                "switch",
                "port"
              ],
              "query": [
                {
                  "key": "port-name",
                  "value": "port1",
                  "disabled": true,
                  "description": "Optional: scope to one port"
                }
              ]
            },
            "description": "THE core dashboard poll: per-port admin/oper status, speed/duplex, and tx/rx byte-, packet- and error-counters for all 24\u00d7GE + 4\u00d7SFP+ ports. Counters are cumulative \u2014 derive rates centrally (delta/interval), like SNMP ifHCInOctets."
          }
        },
